FROM node:22-alpine

WORKDIR /app

# Copy only production dependencies
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Copy server source
COPY admin-server.mjs ./

# Create data directory
RUN mkdir -p /opt/teamost/data

# Non-root user
RUN addgroup -S teamost && adduser -S teamost -G teamost
RUN chown -R teamost:teamost /app /opt/teamost
USER teamost

EXPOSE 3000

ENV PORT=3000
ENV DB_PATH=/opt/teamost/data/licenses.db
ENV JWT_SECRET=teamost-admin-secret-change-me

CMD ["node", "admin-server.mjs"]
